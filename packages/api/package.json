{
  "name": "@payscope/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/server.ts",
    "build": "tsdown",
    "start": "node dist/server.js",
    "worker": "tsx --env-file-if-exists=../../.env.local src/worker-main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env.local src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env.local src/seed/seed-cli.ts",
    "credentials:rotate": "tsx src/crypto/rotate-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "@payscope/provider-adapters": "workspace:*",
    "@payscope/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "openapi-types": "^12.1.3",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@payscope/test-utils": "workspace:*",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "vitest": "5.0.4"
  }
}
