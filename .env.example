# Supabase — https://supabase.com/dashboard/project/<project-ref>/settings/api
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# API server
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Web app
NEXT_PUBLIC_API_URL=http://localhost:3001

# Credential encryption (generate: openssl rand -base64 32)
CREDENTIALS_ENCRYPTION_KEY=your-32-byte-base64-key-here

# Provider keys — added in Phase 5 (sandbox/test credentials only)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_WEBHOOK_ID=...
# PADDLE_API_KEY=...
# PADDLE_WEBHOOK_SECRET=...
# REVENUECAT_API_KEY=...
# REVENUECAT_WEBHOOK_AUTH_HEADER=...
