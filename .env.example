# Supabase — https://supabase.com/dashboard/project/<project-ref>/settings/api
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_JWKS_URL=

# Database (Supabase uses the pooler connection string in deployed envs)
DATABASE_URL=postgresql://postgres@localhost:5432/payscope
DB_POOL_MAX=10
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/payscope_test

# API server
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# "false" or the number of trusted proxy hops in front of the API (Render: 1)
TRUST_PROXY=false

# Job worker: runs inside the API process by default; set false when running `pnpm --filter @payscope/api worker` separately
RUN_WORKER_IN_PROCESS=true
# Enables POST /internal/tick (header x-internal-token); min 16 chars (generate: openssl rand -hex 24)
# INTERNAL_TICK_TOKEN=your-internal-tick-token-here
# Hours between scheduled local reconciliation runs per org, started by the tick; 0 turns them off
# RECONCILIATION_SCHEDULE_INTERVAL_HOURS=24
# Retention in days, applied by the tick; 0 keeps that data forever, see docs/operations.md#data-retention
# RETENTION_EVENT_PAYLOAD_DAYS=30
# RETENTION_FINISHED_JOB_DAYS=30
# RETENTION_IDEMPOTENCY_GRACE_DAYS=7
# RETENTION_SCENARIO_RUN_DAYS=30
# RETENTION_AUDIT_LOG_DAYS=2555

# Web app
NEXT_PUBLIC_API_URL=http://localhost:3001

# Credential encryption, required in production (generate: openssl rand -base64 32)
CREDENTIALS_ENCRYPTION_KEY=your-32-byte-base64-key-here
# Active key version (1 to 255) and retired keys as version:base64 pairs, see docs/security.md
CREDENTIALS_ENCRYPTION_KEY_VERSION=1
# CREDENTIALS_ENCRYPTION_KEYS_PREVIOUS=1:your-previous-32-byte-base64-key-here

# Rate limit overrides per policy, see docs/api.md#rate-limits (e.g. AUTHENTICATED_READ, WEBHOOK_INGRESS)
# RATE_LIMIT_AUTHENTICATED_READ_MAX=300
# RATE_LIMIT_AUTHENTICATED_READ_WINDOW_SEC=60

# Seed: allow a DATABASE_URL host other than localhost (never against production)
# SEED_ALLOW_REMOTE=false

# E2E: password of the Supabase demo users, see docs/demo.md
# DEMO_USER_PASSWORD=your-demo-user-password-here
