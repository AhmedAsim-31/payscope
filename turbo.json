{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV",
        "DATABASE_URL",
        "DB_POOL_MAX",
        "SUPABASE_*",
        "NEXT_PUBLIC_*",
        "API_*",
        "CORS_ORIGIN",
        "LOG_LEVEL",
        "TRUST_PROXY",
        "RUN_WORKER_IN_PROCESS",
        "INTERNAL_TICK_TOKEN",
        "CREDENTIALS_ENCRYPTION_*",
        "RATE_LIMIT_*"
      ]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "passThroughEnv": ["DATABASE_URL", "TEST_DATABASE_URL", "SUPABASE_URL"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/supabase/migrations/**"]
    }
  }
}
