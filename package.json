{
  "name": "payscope",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "pnpm --filter @payscope/api db:seed",
    "db:reset-demo": "pnpm --filter @payscope/api db:seed --reset",
    "e2e": "pnpm --filter @payscope/e2e e2e",
    "e2e:headed": "pnpm --filter @payscope/e2e e2e:headed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "10.12.0",
    "prettier": "^3.9.0",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
